{
  "name": "luma-enhance-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src",
    "preview": "vite preview",
    "postbuild": "node -e \"const f=require('fs');for(const n of f.readdirSync('dist/assets'))if(/^ort-wasm.*\\\\.wasm$/.test(n))f.unlinkSync('dist/assets/'+n)\"",
    "prebuild": "node -e \"const f=require('fs'),s='node_modules/onnxruntime-web/dist/';f.mkdirSync('public/ort',{recursive:true});for(const n of ['ort-wasm-simd-threaded.asyncify.mjs','ort-wasm-simd-threaded.asyncify.wasm','ort-wasm-simd-threaded.mjs','ort-wasm-simd-threaded.wasm'])f.copyFileSync(s+n,'public/ort/'+n)\"",
    "build:artifact": "npm run prebuild && tsc -b && VITE_ORT=wasm VITE_MODEL_FILE=realesr-general-x4v3.onnx.wasm vite build --base=./ --outDir dist-artifact && node -e \"const f=require('fs');for(const n of f.readdirSync('dist-artifact/assets'))if(/^ort-wasm.*\\\\.wasm$/.test(n))f.unlinkSync('dist-artifact/assets/'+n)\""
  },
  "dependencies": {
    "onnxruntime-web": "1.23.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@tailwindcss/vite": "4.1.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.0",
    "globals": "16.4.0",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12"
  }
}